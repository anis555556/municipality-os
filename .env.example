# PostgreSQL database with PostGIS extension enabled
DATABASE_URL="postgresql://municipality:municipality@localhost:5432/municipality_os?schema=public"
# At least 32 random bytes in production. Used to sign authentication tokens.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Initial tenant slug used by the demo seed and public tenant context
DEFAULT_MUNICIPALITY_SLUG="al-bureij"
# Public origin, for example https://municipality.example.org
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional demo accounts: if omitted, seed creates random passwords and prints them once.
DEMO_ADMIN_EMAIL="admin@bureij.local"
DEMO_ADMIN_PASSWORD=""
DEMO_CITIZEN_EMAIL="citizen@bureij.local"
DEMO_CITIZEN_PASSWORD=""
# Optional separately managed system-wide administrator (no municipality membership).
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
